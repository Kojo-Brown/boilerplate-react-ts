# =============================================================================
# boilerplate-react-ts — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in values for your environment.
# Never commit `.env.local` to version control — it is git-ignored by Vite.
#
# All variables must be prefixed with VITE_ to be exposed to browser code.
# They are validated at startup via Zod in src/env.ts.
# =============================================================================

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------

# Base URL of the backend REST API (no trailing slash).
# Used by src/api/client.ts for every request.
# Development default: http://localhost:4000
VITE_API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Auth — OAuth 2.0 PKCE (Google)
# -----------------------------------------------------------------------------

# Google OAuth 2.0 Client ID from https://console.cloud.google.com/
# Required to start the Google sign-in PKCE flow (src/features/auth/oauth.ts).
# Leave blank to disable the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# OAuth redirect URI — must match a value registered in your Google Cloud
# project's "Authorised redirect URIs" list.
# Defaults to: window.location.origin + /auth/callback
VITE_REDIRECT_URI=http://localhost:3000/auth/callback

# Generic OAuth / auth-provider domain (e.g. for Auth0 or a custom IdP).
# Optional — only needed if you replace the default Google provider.
# Example: your-tenant.us.auth0.com
VITE_AUTH_DOMAIN=

# Generic OAuth client ID for non-Google providers.
# Optional — only needed alongside VITE_AUTH_DOMAIN above.
VITE_CLIENT_ID=

# -----------------------------------------------------------------------------
# Developer Experience
# -----------------------------------------------------------------------------

# Set to "true" to mount React Query Devtools and Redux DevTools in the UI.
# Automatically disabled in production builds regardless of this value.
VITE_ENABLE_DEVTOOLS=true

# -----------------------------------------------------------------------------
# Real User Monitoring — Core Web Vitals
# -----------------------------------------------------------------------------

# Collector endpoint that receives batched LCP/INP/CLS reports as a JSON body
# (sent as text/plain so the beacon is never preflighted — see
# docs/web-vitals.md). Prefer a same-origin path.
# Leave blank to disable reporting; with devtools on, metrics are logged to the
# console instead.
VITE_ANALYTICS_URL=

# Share of visits that report vitals, between 0 and 1. The roll happens once
# per visit, so a sampled visit reports all three metrics or none of them.
# Development default: 1 (report every visit).
VITE_VITALS_SAMPLE_RATE=1

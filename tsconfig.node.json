{
  "compilerOptions": {
    "composite": true,
    "outDir": ".tsbuildinfo/node",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "reactCompiler.config.ts",
    "e2e",
    "tooling"
  ]
}
